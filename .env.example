# TravelHub 2.0 - Configuration Template

# --- Django Core ---
SECRET_KEY=your-secret-key-at-least-50-chars
ENCRYPTION_KEY=your-fernet-key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_SALT=optional-salt-for-additional-security
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
MAGIC_LINK_BASE_URL=https://yourdomain.com

# --- Database ---
# Use PostgreSQL in production
DATABASE_URL=postgres://user:password@localhost:5432/travelhub
# Optional: individual DB params (used by backup scripts)
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=travelhub
DB_HOST=localhost
DB_PORT=5432

# --- Redis (Broker for Celery & Cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
# Optional: full Redis URL (overrides REDIS_HOST/PORT/PASSWORD)
REDIS_URL=redis://localhost:6379/0

# --- AI & GDS Parsing ---
GEMINI_API_KEY=your-google-gemini-api-key
GOOGLE_API_KEY=your-google-cloud-api-key
GCP_PROJECT_ID=travelhub-xxxxxx
GCP_LOCATION=us
# Path to service account JSON if needed
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# --- Cloudflare R2 (Media Storage) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=your-custom-domain.r2.dev
USE_R2=True

# --- Email (Resend & SMTP) ---
RESEND_API_KEY=re_your_resend_api_key
RESEND_SIGNING_SECRET=your-resend-signing-secret
DEFAULT_FROM_EMAIL=TravelHub <noreply@yourdomain.com>

# --- Stripe (SaaS Billing) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_BASIC=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...

# --- Telegram (Notifications & Storage) ---
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_ADMIN_ID=your-user-id
TELEGRAM_GROUP_ID=your-group-id

# --- WhatsApp (Evolution API v2) ---
WHATSAPP_MICROSERVICE_URL=http://evolution:8080
WHATSAPP_MICROSERVICE_TOKEN=your-evolution-api-token
EVOLUTION_PUBLIC_URL=http://localhost:8080
EVOLUTION_INSTANCE_TOKEN=your-instance-token
WHATSAPP_NOTIFICATIONS_ENABLED=true

# --- Binance Pay ---
BINANCE_PAY_API_KEY=your-binance-api-key
BINANCE_PAY_SECRET_KEY=your-binance-secret-key
BINANCE_WEBHOOK_SECRET=your-binance-webhook-secret

# --- Marketing & Design ---
UNSPLASH_ACCESS_KEY=your-unsplash-key
UNSPLASH_SECRET_KEY=your-unsplash-secret

# --- PDF Generation (Gotenberg) ---
GOTENBERG_URL=http://gotenberg:3000/forms/chromium/convert/html

# --- Monitoring ---
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
ENVIRONMENT=production
GIT_SHA=your-git-commit-sha

# --- Security ---
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
DJANGO_TESTING=False
